# ============================================================
# 知识库服务（kb/，端口 KB_PORT）
# ============================================================
# 通义百炼 API Key（阿里 DashScope）。同一份 key 同时供：
#   - kb 的 qwen 对话 + text-embedding-v3 向量化
#   - ai_service 的 alibaba（通义千问）provider
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# 知识库 Python 服务端口（Java aicontent 默认代理到该地址）
KB_PORT=8002

# Chroma 向量库持久化目录（相对或绝对路径均可）
CHROMA_DIR=./chroma_data

# 模型配置（一般无需修改）
LLM_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024          # text-embedding-v3 支持 [64,128,256,512,768,1024]
RETRIEVE_TOP_K=5            # 每次检索召回的相关片段数

# ============================================================
# 多模型接入服务（ai_service/，端口 AI_SERVICE_PORT）
# ============================================================
# 豆包 / 火山引擎 API Key（ai_service 专用）
ARK_API_KEY=your-ark-key-here
# ai_service 服务端口（与 KB_PORT 互不冲突）
AI_SERVICE_PORT=8000

# 以下为 ai_service 其他厂商密钥（按需填写，留空则该厂商调用时鉴权失败）
# HUNYUAN_API_KEY=xxx      # 腾讯混元
# DEEPSEEK_API_KEY=xxx     # DeepSeek
# OPENAI_API_KEY=xxx        # OpenAI
# ANTHROPIC_API_KEY=xxx    # Anthropic Claude
