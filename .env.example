# 复制为 .env 并填入你的通义百炼 API Key
# 用于 qwen 对话生成 + text-embedding-v3 向量化
QWEN_API_KEY=sk-your-dashscope-key-here

# 知识库 Python 服务端口（Java aicontent 默认代理到该地址）
KB_PORT=8001

# Chroma 向量库持久化目录（相对或绝对路径均可）
CHROMA_DIR=./chroma_data

# 模型配置（一般无需修改）
LLM_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1536          # text-embedding-v3 默认 1536 维；换模型需同步修改
RETRIEVE_TOP_K=5            # 每次检索召回的相关片段数
